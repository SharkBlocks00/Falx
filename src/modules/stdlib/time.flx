const t = require("_internal::time");

// FUNCTIONS
// PREDEFINED

export const time = t.time;
export const monotonic = t.monotonic;
export const sleep = t.sleep;
export const utcNow = t.utc_now;
export const localNow = t.local_now;

// CUSTOM

export func millis = define() {
    return time() * 1000.0;
}

export func sleepMillis = define(ms) {
    sleep(ms / 1000.0);
}

export func elapsed = define(start) {
    return monotonic() - start;
}