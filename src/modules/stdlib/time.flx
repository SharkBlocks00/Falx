const t = require("_internal::time");

// FUNCTIONS
// PREDEFINED

export let time = t.time;
export let monotonic = t.monotonic;
export let sleep = t.sleep;
export let utcNow = t.utc_now;
export let localNow = t.local_now;

// CUSTOM

export func millis = define() {
    return time() * 1000.0;
}

export func sleepMillis = define(ms) {
    sleep(ms / 1000.0);
}

export func elapsed = define(start) {
    return monotonic() - start;
}