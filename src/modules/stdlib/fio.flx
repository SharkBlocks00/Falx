let f = require("_internal::fio");

// FUNCTIONS
// PREDEFINED

export const open = f.open;
export const close = f.close;
export const read = f.read;
export const write = f.write;

// CUSTOM

export func append = define(path, contents) {
    let file = open(path, "a");
    write(file, contents);
    close(file);
}

export func writeAll = define(path, contents) {
    let file = open(path, "w");
    write(file, contents);
    close(file);
}

export func readAll = define(path) {
    let file = open(path, "r");
    let contents = read(file);
    close(file);
    return contents;
}