const m = require("_internal::math");

// CONSTANTS
export const pi = m.pi;
export const e = m.e;
export const tau = m.tau;
export const phi = m.phi;

export const sqrt2 = m.sqrt2;
export const sqrt3 = m.sqrt3;

export const ln2 = m.ln2;
export const ln10 = m.ln10;
export const log2e = m.log2e;
export const log10e = m.log10e;

export const epsilon = m.epsilon;

// export funcTIONS

// PREDEFINED

export const floor = m.floor;
export const ceil = m.ceil;
export const trunc = m.trunc;
export const sqrt = m.sqrt;

// CUSTOM

// BASIC
export func abs = define(v) {
    if (v < 0) {
        return -v;
    }

    return v;
}

export func sign = define(v) {
    if (v > 0) {
        return 1;
    }

    if (v < 0) {
        return -1;
    }

    return 0;
}

export func min = define(a, b) {
    if (a < b) {
        return a;
    }

    return b;
}

export func max = define(a, b) {
    if (a > b) {
        return a;
    }

    return b;
}

export func clamp = define(v, min, max) {
    if (v < min) {
        return min;
    }

    if (v > max) {
        return max;
    }

    return v;
}

export func frac = define(v) {
    return v - trunc(v);
}

// ADVANCED

export func lerp = define(a, b, t) {
    return a + (b - a) * t;
}

export func inverseLerp = define(a, b, v) {
    return (v - a) / (b - a);
}

export func remap = define(v, fromMin, fromMax, toMin, toMax) {
   let t = inverseLerp(fromMin, fromMax, v);

    return lerp(toMin, toMax, t);
}

export func isEven = define(v) {
    return v % 2 == 0;
}

export func isOdd = define(v) {
    return v % 2 != 0;
}

export func approximately = define(a, b, eps = epsilon) {
    return abs(a-b) <= eps;
}

