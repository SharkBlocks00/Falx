const r = require("_internal::random");

// export funcTIONS

// PREDEFINED

export const random = r.random;
export const randomInt = r.random_int;
export const seed = r.seed;
export const getState = r.get_state;
export const setState = r.set_state;

// CUSTOM

export func randomBool = define() {
    let n = random();
    if (n > 0.5) {
        return true;
   }
   return false;
}

export func randomSign = define() {
    let n = random();
    if (n > 0.5) {
        return -1;
    }
    return 1;
}

export func chance = define(prob) {
    let n = random();
    if (n <= prob) {
        return true;
    }
    return false;
}

