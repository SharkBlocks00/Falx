// let and const both work, and each name becomes its own independent variable
let (a, b, c) = (1, 2, 3);
assert(a == 1);
assert(b == 2);
assert(c == 3);

a = 100;
assert(a == 100);
assert(b == 2);

const (name, age) = ("Falx", 2);
assert(name == "Falx");
assert(age == 2);

// mixed types, and a nested tuple stays a tuple instead of being destructured further
let (n, s, flag, nothing, arr, inner) = (1, "two", true, null, [3, 4], (5, 6));
assert(s == "two");
assert(flag == true);
assert(nothing == null);
assert(arr.size == 2);
assert(inner == (5, 6));

// a single element needs the same trailing comma as a one element tuple
let (only,) = (42,);
assert(only == 42);

// an empty tuple destructures into nothing
let (,,) = (,,);

// the right hand side can be any expression that evaluates to a tuple
let source = (7, 8);
let (first, second) = source;
assert(first == 7);
assert(second == 8);