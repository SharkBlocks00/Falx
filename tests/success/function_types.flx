func divide = define(a: int, b: int): int {
    return a / b;
}

func multiply = define(a = 10, b = 2) {
    return a * b;
}

func showVal = define(x: int | String) {
    output("val: " + x);
}

func logMsg = define(msg: String): void {
    output("[LOG] " + msg);
}

output(divide(20, 4));
output(multiply());
output(multiply(7, 3));
showVal(42);
showVal("hello");
logMsg("finished");
