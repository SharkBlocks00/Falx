// no 'let' needed for variables that already exist
let a = 0;
let b = 0;
let c = 0;
(a, b, c) = (1, 2, 3);
assert(a == 1);
assert(b == 2);
assert(c == 3);

// the whole right hand side is evaluated before anything is assigned, so this is a swap
(a, b) = (b, a);
assert(a == 2);
assert(b == 1);

// rotate three variables
(a, b, c) = (b, c, a);
assert(a == 1);
assert(b == 3);
assert(c == 2);

// it is an expression that evaluates to the tuple, and it chains
let x = 0;
let y = 0;
let result = ((x, y) = (5, 6));
assert(result == (5, 6));
(a, b) = (c, x) = (8, 9);
assert(c == 8 && x == 9);
assert(a == 8 && b == 9);

// assigns to variables from an outer scope
let outer = 0;
let other = 0;
{
    (outer, other) = (10, 20);
}
assert(outer == 10);
assert(other == 20);

// one element
(a,) = (55,);
assert(a == 55);