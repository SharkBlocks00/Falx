let x = 5;
x += 3;
assert(x == 8, "+= should work");
x -= 2;
assert(x == 6, "-= should work");
x *= 4;
assert(x == 24, "*= should work");
x /= 3;
assert(x == 8, "/= should work");
x %= 5;
assert(x == 3, "%= should work");

let i = 0;
i++;
i++;
assert(i == 2, "++ should work");
i--;
assert(i == 1, "-- should work");

struct Counter {
    count = 0;
}
let c = Counter();
c.count += 10;
assert(c.count == 10, "+= should work on struct fields");
c.count++;
assert(c.count == 11, "++ should work on struct fields");

let arr = [1, 2, 3];
arr[0] += 100;
assert(arr[0] == 101, "+= should work on array elements");
arr[1]++;
assert(arr[1] == 3, "++ should work on array elements");

output("compound assignment OK");
