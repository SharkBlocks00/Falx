let a = 15;
let b = 4;

let sum = a + b;
let diff = a - b;
let prod = a * b;
let quot = a / b;

output("sum: " + sum);
output("diff: " + diff);
output("prod: " + prod);
output("quot: " + quot);

let compound = a + b * 2 - 10 / 2;
output("compound: " + compound);

let neg = -a;
output("neg: " + neg);
